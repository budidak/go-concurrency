{{template "base" .}}

{{define "content" }}
    {{$user := .User}}
    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <h1 class="mt-5">Plans</h1>
                <hr>
                <!-- Sunduğumuz üyelik planlarını bir tablo olarak gösterelim -->
                <table class="table table-compact table-striped">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th class="text-center">Price</th>
                            <th class="text-center">Select</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- handlers.go içerisinden app.render() ile bu sayfaya gönderilen 
                            .Data ile aldığımız verinin "plans" keyinin values üzerinde loop kurduk (gold, silver, bronze)-->
                        {{range index .Data "plans"}}
                            <tr>
                                <td>{{.PlanName}}</td>
                                <td class="text-center">{{.PlanAmountFormatted}}/month</td>
                                <td class="text-center">
                                    <!-- Eğer user'ın zaten bir planı varsa, 
                                        ve template'e gönderilen .ID bilgisi database'deki ID bilgisi ile aynıysa -->
                                    {{if and ($user.Plan) (eq $user.Plan.ID .ID)}}
                                        <strong>Current plan</strong>
                                    {{else}}
                                        <a class="btn btn-primary btn-sm" href="#!" onclick="selectPlan('{{.ID}}', '{{.PlanName}}')">Select</a>
                                    {{end}}
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

        </div> 
    </div>
{{end}}

{{define "js"}}
<!-- öncelikle jsdelivr sitesine giderek sweetalert2 kütüphanesini kodumuza ekledik -->
    <script src=" https://cdn.jsdelivr.net/npm/sweetalert2@11.7.1/dist/sweetalert2.all.min.js "></script>
    <script>
        function selectPlan(x, plan){
            // sweetalert2 fonksiyonu
            Swal.fire({
                title: "Subscribe",
                html: "Are you sure you want to be subscribe to the " + plan + "?",
                showCancelButton: true,
                confirmButtonText: "Subscribe",
            }).then((result) => { // buton tıklamasına göre dönen sonucu .then ile değerlendirip yazdık.
                if (result.isConfirmed) {
                    window.location.href = "/subscribe?id=" + x
                }
            })
        }
    </script>
{{end}}
